PORT=4000

# Bunny Stream Library ID (integer string, e.g. 123456)
BUNNY_LIBRARY_ID=your_library_id_here

# Bunny Stream API Key (used for creating and uploading videos)
BUNNY_STREAM_API_KEY=your_stream_api_key_here

# Bunny Read-Only API Key (used for verifying webhook HMAC signatures)
BUNNY_READ_ONLY_API_KEY=your_read_only_api_key_here

# Token Security Key (used for iframe token generation; defaults to BUNNY_STREAM_API_KEY if not specified)
BUNNY_TOKEN_SECURITY_KEY=your_token_security_key_here

# Public HTTPS URL of your webhook listener (e.g. ngrok: https://xxxxx.ngrok-free.app/api/webhooks/bunny)
BUNNY_WEBHOOK_URL=https://your-public-domain.com/api/webhooks/bunny

# Bunny Embed Base URL
BUNNY_EMBED_BASE_URL=https://iframe.mediadelivery.net/embed
